# Template of the deployment environment file. The deploy workflow writes the real .env on the
# droplet from GitHub secrets and variables; this file documents every key and never holds a value.
#
# Never commit a real .env. The ignore rules already exclude it.

# --- Images (set by the workflow from the commit being deployed) ---------------------------------
IMAGE_TAG=
API_IMAGE=
WEB_IMAGE=

# --- Database (Supabase session pooler, IPv4) ----------------------------------------------------
# The parts are used to assemble the Npgsql connection string inside the container, so the password
# never has to survive env-file quoting.
Database__Host=
Database__Port=5432
Database__Name=postgres
Database__User=
Database__PasswordBase64=

# --- Supabase Auth (JWT validation on the API) ---------------------------------------------------
Jwt__Issuer=
Jwt__Audience=authenticated
Jwt__MetadataAddress=

# --- Browser origin allowed by CORS --------------------------------------------------------------
Cors__AllowedOrigins__0=

# --- Supabase Storage (server-side only) ---------------------------------------------------------
Documents__SupabaseUrl=
Documents__SupabaseSecretKey=
Documents__Bucket=documents

# --- HTTP surface --------------------------------------------------------------------------------
Api__PathBase=/api
ASPNETCORE_URLS=http://+:8080
