# Template of the deployment environment file. The deploy workflow writes the real .env on the
# droplet from GitHub secrets and variables; this file documents every key and never holds a value.
#
# Never commit a real .env. The ignore rules already exclude it.

# --- Images (set by the workflow from the commit being deployed) ---------------------------------
IMAGE_TAG=
API_IMAGE=
WEB_IMAGE=

# --- Database (Supabase session pooler, IPv4) ----------------------------------------------------
# The parts are used to assemble the Npgsql connection string inside the container, so the password
# never has to survive env-file quoting.
Database__Host=
Database__Port=5432
Database__Name=postgres
Database__User=
Database__PasswordBase64=

# --- Supabase Auth (JWT validation on the API) ---------------------------------------------------
Jwt__Issuer=
Jwt__Audience=authenticated
Jwt__MetadataAddress=

# --- Browser origin allowed by CORS --------------------------------------------------------------
Cors__AllowedOrigins__0=

# --- Supabase Storage (server-side only) ---------------------------------------------------------
Documents__SupabaseUrl=
Documents__SupabaseSecretKey=
Documents__Bucket=documents

# --- HTTP surface --------------------------------------------------------------------------------
Api__PathBase=/api
ASPNETCORE_URLS=http://+:8080

# --- Azure AI Foundry (worker only; never exposed to the browser) --------------------------------
# Endpoint of the AIServices resource, e.g. https://ai-convenciones-hxetrj.cognitiveservices.azure.com/
AzureAi__Endpoint=
AzureAi__Deployment=clauses-mistral
AzureAi__ApiKey=
AzureAi__ApiVersion=2024-05-01-preview
AzureAi__TimeoutSeconds=90

# --- Azure Document Intelligence (worker only) ---------------------------------------------------
# Endpoint of the FormRecognizer resource, e.g. https://di-convenciones-hxetrj.cognitiveservices.azure.com/
DocumentIntelligence__Endpoint=
DocumentIntelligence__ApiKey=
DocumentIntelligence__ApiVersion=2024-11-30
DocumentIntelligence__ModelId=prebuilt-layout
DocumentIntelligence__TimeoutSeconds=90

# --- Worker kill switch --------------------------------------------------------------------------
# The deploy workflow writes false. Set true only inside a staging exercise window, then back to false.
Worker__Enabled=false

# --- Concurrency, retention and quotas -----------------------------------------------------------
Processing__MaxActiveRunsPerCompany=1
Retention__IntervalMinutes=360
Retention__BatchSize=100