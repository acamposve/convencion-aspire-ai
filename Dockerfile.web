# syntax=docker/dockerfile:1
#
# The SPA is compiled here and served by nginx, which also proxies /api to the API container. One
# origin means no CORS surface and no second hostname to certify.

FROM node:22-bookworm-slim AS build
WORKDIR /web

RUN npm install --global pnpm@10

COPY src/Convenciones.Web/package.json src/Convenciones.Web/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY src/Convenciones.Web/ ./

# Only public values: the publishable key is designed to be visible in the browser. The secret key
# is never a build argument.
ARG VITE_API_BASE_URL=/api
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_SUPABASE_URL=$VITE_SUPABASE_URL \
    VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY

# `pnpm build` runs tsc, vite build and the bundle scan, so the image cannot be built with a
# service-role marker in the output.
RUN pnpm build

FROM nginx:1.27-alpine AS final

COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/dist /usr/share/nginx/html

EXPOSE 80
