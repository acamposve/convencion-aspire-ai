# =============================================================================
# Legacy PHP tree - REMOVED from the repository (T16, docs/operations/legacy-removal.md)
# =============================================================================

# The tree and the MySQL dump are no longer versioned. A local copy, if any, lives outside the
# repository (C:\proyectos\convenciones-legacy-archive) and is never committed.
local/
presenci_ccol.sql
presenci*.sql

# Basura de sistema operativo / Dreamweaver
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
dwsync.xml

# Logs y temporales
*.log
*.tmp

# =============================================================================
# Nuevo stack (.NET + React) — no versionar artefactos de compilación
# =============================================================================

# Salida de compilación .NET (cualquier profundidad)
bin/
obj/
TestResults/
*.user
*.suo
.vs/

# Node / Vite (T7)
node_modules/
dist/
.vite/

# Web environment files. `.env.example` is the committed template; real values never are.
**/.env
**/.env.local
**/.env.*.local
!**/.env.example

# Aspire local
.aspire/

# Deployment secret mounted into the containers by the deploy workflow; never committed.
/secrets/

# Terraform (state and provider cache are never committed)
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.*
crash.log

# Local-only sensitive assets: client audio/transcripts, authorized test contracts and generated
# launch settings must never be committed.
docs/client-feedback/
docs/test/
**/Properties/launchSettings.json

# Internal audit reports and session handoffs: they map the staging host, tenant ids and quota
# figures, and this repository is public. They stay local-only. The tracked diagnosis note below is
# the one exception: it documents a tooling defect, not infrastructure.
docs/audits/*
!docs/audits/foundry-json-output-diagnosis.md
docs/operations/session-handoff-*.md