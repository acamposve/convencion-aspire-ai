# Normalizar únicamente texto; no tocar los binarios (PDFs, imágenes, dump SQL).
* text=auto

*.php   text
*.js    text
*.css   text
*.html  text
*.md    text

# Git hooks are POSIX shell scripts. They MUST keep LF endings: a CRLF shebang or a CRLF line
# makes `sh` fail, which would silently disable the pre-push guard that protects `main`
# (constitution Art. VIII.1, docs/operations/repository-settings.md).
.githooks/* text eol=lf

# Dump de datos reales: byte-exacto, sin normalización de fin de línea.
presenci_cccol.sql binary

*.pdf   binary
*.pps   binary
*.doc   binary
*.jpg   binary
*.jpeg  binary
*.png   binary
*.gif   binary
*.woff  binary
*.woff2 binary
