# API base URL. Use the API address shown by the Aspire dashboard (for example http://localhost:5000).
# Leave empty when the SPA and API are served from the same origin.
VITE_API_BASE_URL=http://localhost:5000

# Supabase Auth — public values. Until T18 provisions a project these stay empty and the sign-in
# screen reports `auth_not_configured` rather than pretending to authenticate.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Never add a service_role key here. Only VITE_-prefixed values reach the browser bundle, and
# `pnpm build` fails if a service-role marker is found in the output.
